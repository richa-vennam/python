   "id": "b453b1e7-bd95-442c-8400-3a5770f2f921",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter book name to borrow:  Python Basics\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Book issued successfully\n",
      "Updated books: {'Python Basics': 2, 'Data Science 101': 0, 'Machine Learning': 2, 'SQL Guide': 1}\n"
     ]
    }
   ],
   "source": [
    "#8\n",
    "books = {\n",
    "    \"Python Basics\": 3,\n",
    "    \"Data Science 101\": 0,\n",
    "    \"Machine Learning\": 2,\n",
    "    \"SQL Guide\": 1\n",
    "}\n",
    "name = input(\"Enter book name to borrow: \")\n",
    "if name not in books:\n",
    "    print(\"Book not found\")\n",
    "elif books[name] == 0:\n",
    "    print(\"Currently unavailable\")\n",
    "else:\n",
    "    books[name] = books[name] - 1\n",
    "    print(\"Book issued successfully\")\n",
    "print(\"Updated books:\", books)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "92e6a906-143c-48c5-8e29-0a5082429878",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Employee dictionary: {'IT': ['Ravi', 'Suresh', 'Divya'], 'HR': ['Anjali', 'Arun'], 'Finance': ['Meena']}\n",
      "IT : 3 employees\n",
      "HR : 2 employees\n",
      "Finance : 1 employees\n"
     ]
    }
   ],
   "source": [
    "#9\n",
    "employees = [\n",
    "    (\"Ravi\", \"IT\"),\n",
    "    (\"Anjali\", \"HR\"),\n",
    "    (\"Suresh\", \"IT\"),\n",
    "    (\"Meena\", \"Finance\"),\n",
    "    (\"Arun\", \"HR\"),\n",
    "    (\"Divya\", \"IT\")\n",
    "]\n",
    "departments = {}\n",
    "for name, department in employees:\n",
    "    if department in departments:\n",
    "        departments[department].append(name)\n",
    "    else:\n",
    "        departments[department] = [name]\n",
    "print(\"Employee dictionary:\", departments)\n",
    "for department, names in departments.items():\n",
    "    print(department, \":\", len(names), \"employees\")"
   ]
  },
  {
   "cell_type": "code",
