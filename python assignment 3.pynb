   ],
   "source": [
    "#10\n",
    "answer_key = (\"B\", \"C\", \"A\", \"D\", \"B\")\n",
    "wrong_questions = set()\n",
    "score = 0\n",
    "for i in range(5):\n",
    "    answer = input(\"Enter answer for question \" + str(i + 1) + \": \").upper()\n",
    "    if answer == answer_key[i]:\n",
    "        print(\"Question\", i + 1, \"is correct\")\n",
    "        score += 1\n",
    "    else:\n",
    "        print(\"Question\", i + 1, \"is wrong\")\n",
    "        wrong_questions.add(i + 1)\n",
    "print(\"Wrong question numbers:\", wrong_questions)\n",
    "print(\"Final score:\", score, \"out of 5\")\n",
    "if score == 5:\n",
    "    print(\"Excellent\")\n",
    "elif score >= 3:\n",
    "    print(\"Good\")\n",
    "else:\n",
    "    print(\"Needs improvement\")"
   ]
  },
