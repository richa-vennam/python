   "source": [
    "#2\n",
    "visits = [101, 205, 101, 330, 205, 412, 101, 330, 509]\n",
    "\n",
    "unique_visitors = set(visits)\n",
    "\n",
    "print(\"Total visits:\", len(visits))\n",
    "print(\"Unique visitors:\", len(unique_visitors))\n",
    "print(\"Unique visitor IDs:\", sorted(unique_visitors))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c284ab8d-0831-4845-9d76-f52a05bb3a34",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Aman Pass\n",
      "Priya Pass\n",
      "Rahul Pass\n",
      "Sneha Pass\n",
      "Kiran Fail\n",
      "Topper: Priya\n",
      "Topper marks: 91\n",
      "Passed students: {'Aman': 82, 'Priya': 91, 'Rahul': 45, 'Sneha': 67}\n"
     ]
    }
   ],
   "source": [
    "#3\n",
    "marks = {\n",
    "    \"Aman\": 82,\n",
    "    \"Priya\": 91,\n",
    "    \"Rahul\": 45,\n",
    "    \"Sneha\": 67,\n",
    "    \"Kiran\": 30\n",
    "}\n",
    "passed = {}\n",
    "for name, mark in marks.items():\n",
    "    if mark >= 40:\n",
    "        print(name, \"Pass\")\n",
    "        passed[name] = mark\n",
    "    else:\n",
    "        print(name, \"Fail\")\n",
    "topper = max(marks, key=marks.get)\n",
    "print(\"Topper:\", topper)\n",
    "print(\"Topper marks:\", marks[topper])\n",
    "print(\"Passed students:\", passed)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "fcee6cbb-4256-43b3-b361-200e1ad5ab16",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Mutual friends: {'Vikram', 'Neha', 'Aman'}\n",
      "Riya's friends only: {'Sita', 'Karan'}\n",
      "All friends: {'Pooja', 'Vikram', 'Rohan', 'Sita', 'Karan', 'Neha', 'Aman'}\n",
      "Friend suggestions: {'Rohan', 'Pooja'}\n"
     ]
    }
   ],
   "source": [
    "#4\n",
    "riya_friends = {\"Aman\", \"Neha\", \"Karan\", \"Sita\", \"Vikram\"}\n",
    "arjun_friends = {\"Neha\", \"Vikram\", \"Pooja\", \"Aman\", \"Rohan\"}\n",
    "print(\"Mutual friends:\", riya_friends & arjun_friends)\n",
    "print(\"Riya's friends only:\", riya_friends - arjun_friends)\n",
    "print(\"All friends:\", riya_friends | arjun_friends)\n",
    "print(\"Friend suggestions:\", arjun_friends - riya_friends)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "bec6449a-ed7b-46e3-8e1e-e234cff2760d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter text:  richa\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{'r': 1, 'i': 1, 'c': 1, 'h': 1, 'a': 1}\n",
      "Most frequent character: r ( 1 times)\n"
     ]
    }
   ],
   "source": [
    "#5\n",
    "text = input(\"Enter text: \")\n",
    "count = {}\n",
    "for ch in text:\n",
    "    if ch != \" \":\n",
    "        if ch in count:\n",
    "            count[ch] = count[ch] + 1\n",
    "        else:\n",
    "            count[ch] = 1\n",
    "print(count)\n",
    "most = max(count, key=count.get)\n",
    "print(\"Most frequent character:\", most, \"(\", count[most], \"times)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "13cd32fa-fc78-4c22-b57e-21914b79783d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter item (or bill to finish):  dosa\n",
      "Enter item (or bill to finish):  coffee\n",
      "Enter item (or bill to finish):  finish\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Item not available\n"
     ]
    },
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter item (or bill to finish):  bill\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total bill: Rs. 85\n",
      "Final bill: Rs. 85\n"
     ]
    }
   ],
   "source": [
    "#6\n",
    "menu = {\n",
    "    \"dosa\": 60,\n",
    "    \"idli\": 40,\n",
    "    \"vada\": 30,\n",
    "    \"coffee\": 25,\n",
    "    \"tea\": 15\n",
    "}\n",
    "\n",
    "total = 0\n",
    "while True:\n",
    "    item = input(\"Enter item (or bill to finish): \")\n",
    "    if item == \"bill\":\n",
    "        break\n",
    "    elif item in menu:\n",
    "        total = total + menu[item]\n",
    "    else:\n",
    "        print(\"Item not available\")\n",
    "print(\"Total bill: Rs.\", total)\n",
    "if total > 200:\n",
    "    discount = total * 10 / 100\n",
    "    total = total - discount\n",
    "    print(\"Discount: Rs.\", discount)\n",
    "print(\"Final bill: Rs.\", total)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "a4fdc7d7-dae8-43d5-8e13-c7b982b489f5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Hyderabad Latitude: 17.38 Longitude: 78.48\n",
      "Mumbai Latitude: 19.07 Longitude: 72.87\n",
      "Chennai Latitude: 13.08 Longitude: 80.27\n",
      "Delhi Latitude: 28.61 Longitude: 77.2\n",
      "Farthest north: Delhi\n",
      "Highest latitude: 28.61\n"
     ]
    }
   ],
   "source": [
    "#7\n",
    "cities = [\n",
    "    (\"Hyderabad\", 17.38, 78.48),\n",
    "    (\"Mumbai\", 19.07, 72.87),\n",
    "    (\"Chennai\", 13.08, 80.27),\n",
    "    (\"Delhi\", 28.61, 77.20)\n",
    "]\n",
    "# Print city coordinates\n",
    "for name, latitude, longitude in cities:\n",
    "    print(name, \"Latitude:\", latitude, \"Longitude:\", longitude)\n",
    "# Find the city farthest north\n",
    "north = cities[0]\n",
    "for city in cities:\n",
    "    if city[1] > north[1]:\n",
    "        north = city\n",
    "print(\"Farthest north:\", north[0])\n",
    "print(\"Highest latitude:\", north[1])"
   ]
  },
  {
