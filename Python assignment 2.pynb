   "source": [
    "# 10\n",
    "name = input(\"Enter your full name: \")\n",
    "words = name.split()\n",
    "# Print initials\n",
    "for word in words:\n",
    "    print(word[0].upper(), end=\".\")\n",
    "# Print name in title case\n",
    "print()\n",
    "print(\"Title case:\", name.title())\n",
    "# Print first initials and full surname\n",
    "print(\"Surname format:\", end=\" \")\n",
    "for i in range(len(words) - 1):\n",
    "    print(words[i][0].upper(), end=\". \")\n",
    "print(words[-1].title())"
   ]
  },
