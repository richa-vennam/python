     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter password:  richa rao\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Medium\n"
     ]
    }
   ],
   "source": [
    "#9\n",
    "password = input(\"Enter password: \")\n",
    "upper = 0\n",
    "lower = 0\n",
    "digit = 0\n",
    "for ch in password:\n",
    "    if ch.isupper():\n",
    "        upper = 1\n",
    "    elif ch.islower():\n",
    "        lower = 1\n",
    "    elif ch.isdigit():\n",
    "        digit = 1\n",
    "length = 0\n",
    "if len(password) >= 8:\n",
    "    length = 1\n",
    "total = upper + lower + digit + length\n",
    "if total == 4:\n",
    "    print(\"Strong\")\n",
    "elif total >= 2:\n",
    "    print(\"Medium\")\n",
    "else:\n",
    "    print(\"Weak\")"
   ]
  },
  {
