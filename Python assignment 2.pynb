     "text": [
      "Heat alert: Wed\n",
      "Heat alert: Thu\n",
      "Heat alert: Sun\n",
      "Hottest day: Thu\n",
      "Temperature: 41\n",
      "Fahrenheit temperatures: [89.6, 95.0, 100.4, 105.8, 96.8, 84.2, 104.0]\n"
     ]
    }
   ],
   "source": [
    "#6\n",
    "temps = [32, 35, 38, 41, 36, 29, 40]\n",
    "days = [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"]\n",
    "# Heat alert\n",
    "for i in range(7):\n",
    "    if temps[i] > 37:\n",
    "        print(\"Heat alert:\", days[i])\n",
    "# Hottest day\n",
    "hottest = max(temps)\n",
    "position = temps.index(hottest)\n",
    "print(\"Hottest day:\", days[position])\n",
    "print(\"Temperature:\", hottest)\n",
    "# Convert Celsius to Fahrenheit\n",
    "fahrenheit = []\n",
    "for t in temps:\n",
    "    f = t * 9/5 + 32\n",
    "    fahrenheit.append(f)\n",
    "print(\"Fahrenheit temperatures:\", fahrenheit)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "e8a61869-e9bb-4880-b30e-85b68f29e605",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Positive accounts: [1500, 3000, 750]\n",
      "Negative accounts: [-200, -50, -1000]\n",
      "Total amount owed: 1250\n"
     ]
    }
   ],
   "source": [
    "#8\n",
    "balances = [1500, -200, 3000, -50, 0, 750, -1000]\n",
    "positive_accounts = []\n",
    "negative_accounts = []\n",
    "for balance in balances:\n",
    "    if balance > 0:\n",
    "        positive_accounts.append(balance)\n",
    "    elif balance < 0:\n",
    "        negative_accounts.append(balance)\n",
    "print(\"Positive accounts:\", positive_accounts)\n",
    "print(\"Negative accounts:\", negative_accounts)\n",
    "total_owed = sum(negative_accounts) * -1\n",
    "print(\"Total amount owed:\", total_owed)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "764aa608-ede3-4aa6-b657-1cc1af5d2372",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a sentence:  i like python\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Longest word: python\n",
      "Shortest word: i\n",
      "Words starting with capital letter: 0\n"
     ]
    }
   ],
   "source": [
    "#7\n",
    "sentence = input(\"Enter a sentence: \")\n",
    "words = sentence.split()\n",
    "longest = words[0]\n",
    "shortest = words[0]\n",
    "count = 0\n",
    "for word in words:\n",
    "    if len(word) > len(longest):\n",
    "        longest = word\n",
    "    if len(word) < len(shortest):\n",
    "        shortest = word\n",
    "    if word[0].isupper():\n",
    "        count += 1\n",
    "print(\"Longest word:\", longest)\n",
    "print(\"Shortest word:\", shortest)\n",
    "print(\"Words starting with capital letter:\", count)"
   ]
  },
  {
   "cell_type": "code",
