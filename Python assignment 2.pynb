   "source": [
    "#3\n",
    "username = input(\"Enter username: \")\n",
    "if len(username) < 5 or len(username) > 12:\n",
    "    print(\"Invalid: Username must be 5 to 12 characters\")\n",
    "elif \" \" in username:\n",
    "    print(\"Invalid: Username cannot contain spaces\")\n",
    "elif username[0].isdigit():\n",
    "    print(\"Invalid: Username cannot start with a digit\")\n",
    "else:\n",
    "    print(\"Valid username\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "3c1be7a6-d2a0-45e8-a189-e8a419f8226f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter Tweet:  richa\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Vowels: 2\n",
      "Consonants: 3\n",
      "Spaces: 0\n"
     ]
    }
   ],
   "source": [
    "#4\n",
    "tweet = input(\"Enter Tweet: \")\n",
    "vowels = 0\n",
    "consonants = 0\n",
    "spaces = 0\n",
    "for letter in tweet:\n",
    "    if letter in \"aeiouAEIOU\":\n",
    "        vowels += 1\n",
    "    elif letter == \" \":\n",
    "        spaces += 1\n",
    "    elif letter.isalpha():\n",
    "        consonants += 1\n",
    "print(\"Vowels:\", vowels)\n",
    "print(\"Consonants:\", consonants)\n",
    "print(\"Spaces:\", spaces)"
   ]
  },
  {
   "cell_type": "code",
