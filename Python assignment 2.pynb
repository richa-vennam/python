   "source": [
    "#5\n",
    "name = input(\"Enter your name: \")\n",
    "name = name.lower()\n",
    "if name == name[::-1]:\n",
    "    print(\"Bonus! Your name is a palindrome.\")\n",
    "else:\n",
    "    print(\"Sorry! Your name is not a palindrome.\")"
   ]
  },
